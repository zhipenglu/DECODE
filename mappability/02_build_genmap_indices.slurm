#!/bin/bash
#SBATCH --job-name=genmap_idx
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=logs/genmap_idx_%j.out
#SBATCH --error=logs/genmap_idx_%j.err

# =============================================================================
# DECODE Mappability Step 2: Build Dual-Strand GenMap FM-Indices
# =============================================================================
# Builds GenMap suffix-array / FM-indices for both the dual-strand 4-base
# (A/C/G/T) reference and the dual-strand 2-base (G/T) reference generated by
# `01_prepare_refs_and_beds.py`.
#
# Usage:
#   sbatch mappability/02_build_genmap_indices.slurm
# =============================================================================

set -euo pipefail

REFS_DIR="${REFS_DIR:-refs_dual_strand}"
IDX_DIR="${IDX_DIR:-genmap_indices}"

mkdir -p "${IDX_DIR}" logs

# Remove any incomplete index directories (`genmap index` requires fresh paths)
rm -rf "${IDX_DIR}/idx_4base" "${IDX_DIR}/idx_2base_GT"

echo "[$(date)] Indexing dual-strand 4-base genome..."
genmap index \
    -F "${REFS_DIR}/genome_4base_dual.fa" \
    -I "${IDX_DIR}/idx_4base"

echo "[$(date)] Indexing dual-strand 2-base (G/T) genome..."
genmap index \
    -F "${REFS_DIR}/genome_2base_GT_dual.fa" \
    -I "${IDX_DIR}/idx_2base_GT"

echo "[$(date)] Finished building GenMap indices in ${IDX_DIR}/."
